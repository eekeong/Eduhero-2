rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core authentication checks
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/roles/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role 
        : 'guest';
    }
    
    function getUserId() {
      return isAuthenticated() && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        ? get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.userId 
        : null;
    }

    // Is this user document the caller's own?
    // Checks the STORED uid, not the incoming one — see the users/ update rule.
    // Uses .get(field, default) throughout: legacy user documents have no `uid`
    // field at all, and a bare resource.data.uid would raise an evaluation error
    // rather than cleanly evaluating to false.
    function ownsUserDoc(userId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.get('uid', '') == request.auth.uid;
    }

    function userDocRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.get('role', '');
    }

    // ── ROLES ──────────────────────────────────────────────
    // This collection decides everyone's role, so a forgeable write here is a
    // full privilege escalation. Creating a roles doc is only allowed when it
    // agrees with a user document that ALREADY claims the caller's uid — which
    // is exactly what the self-repair path in store.fetchUserByUid() does, and
    // is not something a freshly signed-up account can satisfy.
    match /roles/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || getUserRole() == 'admin');

      allow create: if isAuthenticated()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['role', 'userId'])
        && ownsUserDoc(request.resource.data.userId)
        && request.resource.data.role == userDocRole(request.resource.data.userId);

      allow update, delete: if isAuthenticated() && getUserRole() == 'admin';
    }

    // ── USERS ──────────────────────────────────────────────
    match /users/{userId} {
      // Reading a user document exposes the mirrored plaintext password, so this
      // is admin-or-self only. There is deliberately no unauthenticated access:
      // the old `list: if request.query.limit <= 1` let anyone on the internet
      // read any single user document without logging in.
      allow get: if isAuthenticated() && (
        getUserRole() == 'admin' ||
        getUserId() == userId ||
        resource.data.get('uid', '') == request.auth.uid
      );

      // Queries: the admin console lists everyone; everyone else may only run a
      // query that is already constrained to their own document
      // (store.fetchUserByUid's `where('uid','==',myUid)` self-repair lookup).
      allow list: if isAuthenticated() && (
        getUserRole() == 'admin' ||
        resource.data.get('uid', '') == request.auth.uid
      );

      // Update: admins may change anything; a user may only touch their own
      // document, and only the session/activity bookkeeping fields.
      //
      // The previous rule keyed off request.resource.data.uid — the value being
      // WRITTEN, which the caller controls — so any signed-in user could rewrite
      // any other user's document just by setting uid to their own. It now keys
      // off resource.data.uid, the value already stored.
      //
      // Note this branch does NOT depend on the roles document, because the
      // other self-update branches in the old rule could never pass (on an
      // update, request.resource.data is the merged document, so
      // `!("role" in request.resource.data)` was always false) and every
      // non-admin write was in practice riding on the uid branch above.
      allow update: if isAuthenticated() && (
        getUserRole() == 'admin' ||
        (
          resource.data.get('uid', '') == request.auth.uid &&
          request.resource.data.get('uid', '') == resource.data.get('uid', '') &&
          request.resource.data.get('role', '') == resource.data.get('role', '') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastSessionId', 'lastLoginAt', 'lastActiveAt', 'mustChangePassword', 'password'
          ])
        )
      );

      allow create, delete: if isAuthenticated() && getUserRole() == 'admin';
    }

    // ── SETTINGS ───────────────────────────────────────────
    match /settings/{doc} {
      // Anyone can read settings (for login page branding).
      allow read: if true;
      // Only admins can change settings.
      allow write: if getUserRole() == 'admin';
    }

    // ── SUBJECTS ───────────────────────────────────────────
    match /subjects/{subjectId} {
      // All authenticated users can read subjects.
      // The old `list: if request.query.limit <= 1` existed for the pre-login
      // "is the database empty?" seed check; that check already swallows a
      // permission-denied, so it costs nothing and closes another public read.
      allow read: if isAuthenticated();
      // Only admins manage subjects.
      allow write: if getUserRole() == 'admin';
    }

    // ── VIDEOS ─────────────────────────────────────────────
    match /videos/{videoId} {
      allow read: if isAuthenticated();
      // Admins can create/update. Teachers can only create/update their own videos.
      // Students can ONLY update the 'views' counter.
      allow create: if getUserRole() == 'admin' || (getUserRole() == 'teacher' && request.resource.data.teacherId == getUserId());
      allow update: if getUserRole() == 'admin' || 
                       (getUserRole() == 'teacher' && request.resource.data.teacherId == getUserId()) ||
                       (getUserRole() == 'student' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']));
      // Admins can delete. Teachers can delete their own videos.
      allow delete: if getUserRole() == 'admin' || (getUserRole() == 'teacher' && resource.data.teacherId == getUserId());
    }

    // ── PROGRESS ───────────────────────────────────────────
    match /progress/{progressId} {
      // Admins and Teachers can read all progress. Students can read their own.
      allow read: if getUserRole() == 'admin' || getUserRole() == 'teacher' || (getUserRole() == 'student' && resource.data.studentId == getUserId());
      // Students can update their own progress.
      allow create, update: if getUserRole() == 'student' && request.resource.data.studentId == getUserId();
      allow delete: if getUserRole() == 'admin';
    }

    // ── COMMENTS ───────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == getUserId();
      allow update, delete: if getUserRole() == 'admin' || resource.data.userId == getUserId();
    }

    // ── ACTIVITY LOG ───────────────────────────────────────
    match /activityLog/{logId} {
      // Only admins can read the activity log.
      allow read: if getUserRole() == 'admin';
      // Any authenticated user can create a log entry (since frontend logs actions).
      allow create: if isAuthenticated();
      // Only admins can clear the log (delete).
      allow update, delete: if getUserRole() == 'admin';
    }
    // ── SECRETS ───────────────────────────────────────────
    match /secrets/{doc} {
      allow read: if getUserRole() == 'admin' || getUserRole() == 'teacher';
      allow write: if getUserRole() == 'admin';
    }
  }
}
